{
  "name": "cellar-door-exit",
  "version": "0.1.0",
  "type": "module",
  "description": "Verifiable EXIT markers — the authenticated declaration of departure that preserves continuity across contexts.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "exit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "build:tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "demo:voluntary": "npx tsx src/demo/scenario1-voluntary.ts",
    "demo:emergency": "npx tsx src/demo/scenario2-emergency.ts",
    "demo:successor": "npx tsx src/demo/scenario3-successor.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "commander": "^14.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "fast-check": "^3.22.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0"
}
